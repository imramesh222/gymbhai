# Production settings. Copy to .env.prod on the server; never commit it.
# docs/DEPLOY.md explains each step.

# --- Domains and HTTPS ---
APP_DOMAIN=app.gymbhai.com
ROOT_DOMAIN=gymbhai.com
ACME_EMAIL=you@example.com
PUBLIC_APP_URL=https://app.gymbhai.com

# --- Database ---
POSTGRES_USER=gymbhai
# python3 -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=
POSTGRES_DB=gymbhai

# --- Security ---
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Two-step sign-in secrets are derived from this; a different value from
# SECRET_KEY, generated the same way. Changing it breaks everyone's
# authenticator app. Required outside local development.
TOTP_KEY=
# Caddy is the one proxy in front of the API.
TRUSTED_PROXY_COUNT=1

# --- SMS (PLAN.md §15: choose a gateway, then send a test message) ---
# SPARROW_SENDER is the identity Sparrow gives the account, not a name you
# pick: their shared sender until a sender ID of your own is approved by the
# operators. Sparrow answers only calls from IP addresses whitelisted on the
# account, so give them this server's address. Leave SMS_PROVIDER=console
# until `python -m scripts.sms_check` passes (docs/DEPLOY.md §5).
SMS_PROVIDER=console
# While SMS_PROVIDER is console no sign-in code reaches anyone, so members
# sign in with this shared 6-digit code instead (the gym tells them). It works
# for any registered member of any gym, so keep it to the people who need it.
# Remove it when switching to a real gateway: the app refuses to start with
# both (docs/DEPLOY.md §5).
MASTER_OTP=
SPARROW_TOKEN=
SPARROW_SENDER=
AAKASH_TOKEN=
TRIAL_SMS_CREDITS=50

# --- Notifications on members' phones (PLAN.md §16.3, 8.3) ---
# Run `make vapid` once and keep the key: changing it means every member turns
# reminders on again. Without a key everything goes by SMS.
PUSH_PROVIDER=webpush
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gymbhai.com

# --- Help: our WhatsApp/Viber number, digits with country code (977...) ---
SUPPORT_WHATSAPP=

# --- Email, for members' sign-in codes ---
# Gmail with an app password works and is free (about 500 a day), but sends
# as your Gmail address. Once gymbhai.com has email, use that instead so
# members see it coming from GymBhai.
EMAIL_PROVIDER=console
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=gymbhai <no-reply@gymbhai.com>

# --- Files and backups: an S3-compatible bucket, e.g. Cloudflare R2 ---
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_BUCKET=gymbhai-files
# A separate bucket, so no app bug can touch the backups.
BACKUP_BUCKET=gymbhai-backups
BACKUP_KEEP_DAYS=30

# --- Where gyms pay GymBhai (shown on their Subscription screen) ---
PLATFORM_PAY_TO_NAME=
PLATFORM_PAY_TO_ESEWA=
PLATFORM_PAY_TO_BANK=

# --- Monitoring (optional) ---
SENTRY_DSN=
