# Copy to .env (`make env` does it). Never commit .env.

# --- Postgres (read by docker compose) ---
POSTGRES_USER=gymbhai
POSTGRES_PASSWORD=gymbhai
POSTGRES_DB=gymbhai
# Host port for the db container. 5433 because a local Postgres usually holds 5432.
POSTGRES_PORT=5433

# --- Backend ---
# Used when running the API or tests on the host. Inside compose the api and
# worker services override it to reach the database at host "db".
DATABASE_URL=postgresql+psycopg://gymbhai:gymbhai@localhost:5433/gymbhai
ENVIRONMENT=local

# Signs staff access tokens. Changing it signs everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder is refused outside local development.
SECRET_KEY=dev-only-change-me
# Two-step sign-in secrets are derived from this (required in production;
# here SECRET_KEY stands in when it is empty).
TOTP_KEY=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Free trial for a newly signed-up gym (PLAN.md §5.7).
TRIAL_DAYS=14

# How many proxies of OURS sit in front of the API, so the client address in
# the activity log is the caller's and not a proxy's. In development the
# Next.js server proxies /api, so 1. In production Caddy + Next.js, so 2.
TRUSTED_PROXY_COUNT=1

# Seconds between the worker's checks for due jobs.
WORKER_POLL_SECONDS=5

# --- Host ports ---
API_PORT=8000
WEB_PORT=3000

# --- SMS: reminders and notices (PLAN.md §15) ---
# "console" prints messages to the log and costs nothing; development uses it.
# With a Sparrow account, uncomment these two and restart. The sender is the
# identity Sparrow gives the account: their shared one until a sender ID of
# your own is registered with the operators. Sparrow also only accepts calls
# from IP addresses whitelisted on the account.
SMS_PROVIDER=console
# SPARROW_TOKEN=
# SPARROW_SENDER=InfoSMS

# --- Notifications on members' phones (PLAN.md §16.3, 8.3) ---
# Members who turn on reminders in their app get a free notification instead
# of an SMS. Needs a key: run `make vapid` and paste its line here. Changing
# the key later means every member turns reminders on again. "console" logs
# what would be sent; "webpush" sends it (works on localhost in Chrome).
PUSH_PROVIDER=console
VAPID_PRIVATE_KEY=0

# --- WhatsApp messages to members (PLAN.md §19.3) ---
# Between push (free) and SMS, for gyms that turn it on and members who agree.
# "console" logs what would be sent. "meta" needs GymBhai's verified Meta
# business, our number's id, a System User token, the app secret (webhooks are
# signed with it) and a verify token of your choosing, typed into Meta's
# webhook settings with https://<domain>/api/v1/whatsapp/webhook
# (docs/WHATSAPP.md).
WHATSAPP_PROVIDER=console
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=

# --- Members' app payments confirmed by the wallet (PLAN.md §20.2) ---
# A gym with its own eSewa, Khalti or Fonepay merchant account can have app
# payments confirmed by the wallet, with no approval at the desk. "console"
# shows a pretend checkout on our own page (development); on a server it
# leaves the feature off. "live" calls the wallets with each gym's keys, which
# are encrypted with GATEWAY_KEY (at least 32 random characters: changing it
# makes every gym enter its keys again). docs/PAYMENTS.md.
GATEWAY_PROVIDER=console
# GATEWAY_KEY=

# --- Tax invoices for VAT-registered gyms (PLAN.md §20.4) ---
# GymBhai is not IRD-certified billing software yet: leave this false on every
# server until IRD certifies it (docs/TAX_INVOICES.md). Local development and
# tests have tax invoices whatever it says.
TAX_INVOICES_CERTIFIED=false
# Each bill to IRD's CBMS: "console" logs it; "live" sends it with each gym's
# own CBMS login.
CBMS_PROVIDER=console

# Our WhatsApp/Viber number for Help in the staff dashboard (PLAN.md §16.5,
# 10.3): country code and number, digits only. Empty: Help shows the guides.
SUPPORT_WHATSAPP=

# --- Email: members' sign-in codes (free; they cost no SMS credit) ---
# "console" prints them to the log (make logs). For real email, Gmail works:
# turn on 2-step verification, then Google Account > Security > App passwords,
# and paste that 16-character password below. Gmail sends about 500 a day.
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=GymBhai <you@gmail.com>

# Members can also sign in with this while there is no SMS gateway
# (PLAN.md §15). Locally OTP_TEST_CODE below already does that.
# MASTER_OTP=

# --- End-to-end tests only ---
# Every member sign-in code is this. Refused outside ENVIRONMENT=local/test.
# OTP_TEST_CODE=246810
