# Copy to .env (`make env` does it). Never commit .env.

# --- Postgres (read by docker compose) ---
POSTGRES_USER=gymbhai
POSTGRES_PASSWORD=gymbhai
POSTGRES_DB=gymbhai
# Host port for the db container. 5433 because a local Postgres usually holds 5432.
POSTGRES_PORT=5433

# --- Backend ---
# Used when running the API or tests on the host. Inside compose the api and
# worker services override it to reach the database at host "db".
DATABASE_URL=postgresql+psycopg://gymbhai:gymbhai@localhost:5433/gymbhai
ENVIRONMENT=local

# Signs staff access tokens. Changing it signs everyone out.
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# The placeholder is refused outside local development.
SECRET_KEY=dev-only-change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# Free trial for a newly signed-up gym (PLAN.md §5.7).
TRIAL_DAYS=14

# How many proxies of OURS sit in front of the API, so the client address in
# the activity log is the caller's and not a proxy's. In development the
# Next.js server proxies /api, so 1. In production Caddy + Next.js, so 2.
TRUSTED_PROXY_COUNT=1

# Seconds between the worker's checks for due jobs.
WORKER_POLL_SECONDS=5

# --- Host ports ---
API_PORT=8000
WEB_PORT=3000

# --- SMS: reminders and notices (PLAN.md §15) ---
# "console" prints messages to the log and costs nothing; development uses it.
# With a Sparrow account, uncomment these two and restart. The sender is the
# identity Sparrow gives the account: their shared one until a sender ID of
# your own is registered with the operators. Sparrow also only accepts calls
# from IP addresses whitelisted on the account.
SMS_PROVIDER=console
# SPARROW_TOKEN=
# SPARROW_SENDER=InfoSMS

# --- Email: members' sign-in codes (free; they cost no SMS credit) ---
# "console" prints them to the log (make logs). For real email, Gmail works:
# turn on 2-step verification, then Google Account > Security > App passwords,
# and paste that 16-character password below. Gmail sends about 500 a day.
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
EMAIL_FROM=GymBhai <you@gmail.com>

# --- End-to-end tests only ---
# Every member sign-in code is this. Refused outside ENVIRONMENT=local/test.
# OTP_TEST_CODE=246810
