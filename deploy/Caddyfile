# HTTPS for GymBhai (PLAN.md §3, §13). Caddy gets and renews the certificates.
{
	email {$ACME_EMAIL}
}

{$APP_DOMAIN} {
	# Live updates (backend/app/services/live.py) are a stream, and the
	# phone app's a WebSocket (/api/v1/m/ws, PLAN.md §17.3): never
	# compressed, which would hold small events back, and flushed at once.
	# A config reload keeps them open a while instead of cutting them all.
	@live path /api/v1/live /api/v1/m/live /api/v1/m/ws
	handle @live {
		reverse_proxy api:8000 {
			flush_interval -1
			stream_close_delay 5m
		}
	}
	# The API directly, skipping the Next.js proxy: one hop fewer.
	# TRUSTED_PROXY_COUNT=1 in .env.prod matches this single hop.
	handle /api/* {
		encode zstd gzip
		# JSON and images: nothing in them may run or be framed. Pages get
		# their own policy, with a per-request nonce, from Next.js
		# (frontend/src/proxy.ts).
		header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		reverse_proxy api:8000
	}
	handle /health* {
		reverse_proxy api:8000
	}
	# ZKTeco and eSSL readers call this path, as their ADMS protocol has it
	# (PLAN.md §18.2, docs/READERS.md): straight to the API, HTTPS only.
	handle /iclock/* {
		reverse_proxy api:8000
	}
	handle {
		encode zstd gzip
		reverse_proxy web:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# The kiosk and the staff scanner need the camera; nothing needs more.
		Permissions-Policy "camera=(self), microphone=(), geolocation=()"
		# Browsers too old for CSP frame-ancestors: no framing either.
		X-Frame-Options "DENY"
		-Server
	}
}

# The bare domain goes to the app until there is a marketing site.
{$ROOT_DOMAIN} {
	redir https://{$APP_DOMAIN}{uri}
}
