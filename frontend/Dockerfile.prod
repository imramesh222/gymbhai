# Production image: a built, standalone Next.js server. Built from the repo
# root (docker-compose.prod.yml) because it needs shared/ beside frontend/.
FROM node:24-slim AS build
WORKDIR /work/frontend
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY frontend/ ./
COPY shared/ ../shared/
# Fixed at build time (next.config.ts). In production Caddy routes /api to the
# API itself, so this is only a fallback.
ARG API_INTERNAL_URL=http://api:8000
ENV API_INTERNAL_URL=$API_INTERNAL_URL NEXT_TELEMETRY_DISABLED=1
RUN npm run build

FROM node:24-slim
WORKDIR /app
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000
# Traced from the repo root, the server sits in frontend/ inside standalone/.
COPY --from=build /work/frontend/.next/standalone ./
COPY --from=build /work/frontend/.next/static ./frontend/.next/static
COPY --from=build /work/frontend/public ./frontend/public
USER node
EXPOSE 3000
CMD ["node", "frontend/server.js"]
